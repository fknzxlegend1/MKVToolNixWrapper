<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Berserk.ico</ApplicationIcon>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Info.txt" />
    <None Remove="Assets\SH2Menu.wav" />
    <None Remove="Assets\SH3Menu.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Berserk.ico" />
    <EmbeddedResource Include="Assets\Info.txt" />
    <EmbeddedResource Include="Assets\SH2Menu.wav" />
    <EmbeddedResource Include="Assets\SH3Menu.wav" />
  </ItemGroup>

</Project>
