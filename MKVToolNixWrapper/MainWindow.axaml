<Window x:Class="MKVToolNixWrapper.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MKVToolNixWrapper"
        x:CompileBindings="False"
        Title="MKVToolNixWrapper" Height="900" Width="1580"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">
    <Window.Resources>
        <local:FileStatusBrushConverter x:Key="FileStatusBrushConverter" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E6EF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#687386" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#315EFB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#315EFB" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#E1E6EF" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.48" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#566276" />
            <Setter Property="Background" Value="#F5F7FB" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Border">
            <Setter Property="BorderBrush" Value="#B9C9FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,240" Margin="24">
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock Text="MKVToolNix Wrapper" FontSize="24" FontWeight="SemiBold"
                               Foreground="#192336" />
                    <TextBlock Text="Review tracks and process your MKV files in batches."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" x:Name="BrowseFolderButton" Content="Browse folder"
                            MinWidth="120" Classes="primary" Click="BrowseFolderButton_Click" />
                    <TextBlock Grid.Column="1" x:Name="SelectedFolderPathLabel"
                               Text="Please select a directory to process"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedBrush}" Margin="16,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AnalyseButton" Content="Analyse" MinWidth="92"
                                Classes="subtle" Click="AnalyseButton_Click" />
                        <Button x:Name="BatchButton" Content="Start batch" MinWidth="112"
                                Classes="primary" Click="BatchButton_Click" />
                        <Button x:Name="HelpButton" Content="Help" MinWidth="76"
                                Classes="subtle" Click="HelpButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="5*,12,7*" Margin="0,0,0,16">
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Files" FontSize="17" FontWeight="SemiBold" Foreground="#192336" />
                            <TextBlock Text="Select the episodes for this batch."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#D95B59" Margin="2,0,5,0" />
                        <TextBlock Text="Analysis failed" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="#E9A629" Margin="2,0,5,0" />
                        <TextBlock Text="Processing" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="#35A66F" Margin="2,0,5,0" />
                        <TextBlock Text="Complete" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="SelectAllFileButton" Content="Select all" Classes="subtle"
                                Margin="0,0,6,6" Click="SelectAllFileButton_Click" />
                        <Button x:Name="SelectNoneFileButton" Content="Select none" Classes="subtle"
                                Margin="0,0,6,6" Click="SelectNoneFileButton_Click" />
                        <Button x:Name="InvertFileButton" Content="Invert" Classes="subtle"
                                Margin="0,0,6,6" Click="InvertFileButton_Click" />
                        <Button x:Name="DeselectFailsButton" Content="Deselect fails" Classes="subtle"
                                Margin="0,0,6,6" Click="DeselectFailsButton_Click" />
                        <Button x:Name="SelectUnprocessedButton" Content="Select unprocessed" Classes="subtle"
                                Margin="0,0,0,6" Click="SelectUnprocessedButton_Click" />
                    </WrapPanel>
                    <ListBox x:Name="FileListBox" Grid.Row="3" ItemsSource="{Binding FileList}"
                             SelectionMode="Multiple" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource FileStatusBrushConverter}}"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="6" Padding="6,4" Margin="0,1">
                                    <CheckBox Content="{Binding FilePath}"
                                              IsChecked="{Binding Include, Mode=TwoWay}"
                                              Click="FileListBoxCheckBox_Click" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                    HorizontalAlignment="Center" Margin="0,12" />

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Tracks" FontSize="17" FontWeight="SemiBold" Foreground="#192336" />
                            <TextBlock Text="Analyse files first, then customize included tracks."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectNoneTrackButton" Content="Select none" Classes="subtle"
                                    Click="SelectNoneTrackButton_Click" />
                            <Button x:Name="SelectAllTrackButton" Content="Select all" Classes="subtle"
                                    Click="SelectAllTrackButton_Click" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="TrackGrid" Grid.Row="1" ItemsSource="{Binding TrackList}"
                              CellEditEnding="OnCellEditEnding" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Include" Binding="{Binding Include}" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Language" Binding="{Binding Language}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Default" Binding="{Binding Default}" />
                            <DataGridCheckBoxColumn Header="Forced" Binding="{Binding Forced}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" Foreground="#192336" />
                        <TextBlock Text="Analysis and batch output appears here."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <CheckBox x:Name="AttachmentsCheckbox" Content="Remove attachments"
                                  HorizontalAlignment="Right" IsChecked="False" />
                        <TextBlock Text="Cover art, fonts, and other embedded files"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="OutputTextBox" Grid.Row="1" IsReadOnly="True" Cursor="Arrow"
                         CaretBrush="Transparent" Background="#F7F8FB" BorderBrush="#E8ECF3"
                         CornerRadius="7" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
